DB_HOST=localhost
DB_PORT=3307
DB_DATABASE=uzze
DB_USER=uzze_user
DB_PASSWORD=uzze_password
DB_ROOT_PASSWORD=rootpassword

# JWT secrets. Replace before deploying — defaults will fail in production.
JWT_SECRET=your-jwt-secret
# JWT_EXPIRATION accepts seconds (number) or jsonwebtoken StringValue like "1h"
JWT_EXPIRATION=3600
JWT_REFRESH_SECRET=your-jwt-refresh-secret
JWT_REFRESH_EXPIRATION=604800

PORT=3000
